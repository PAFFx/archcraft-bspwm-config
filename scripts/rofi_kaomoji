EOF

mkdir -p "${RECENT%/*}"
touch "$RECENT"

# Recents first (keeping their tags), then the rest. Piped directly: NUL bytes can't live in a bash var.
pick=$(awk -v recent_file="$RECENT" -v synonyms="$SYNONYMS" '
	BEGIN {
		n = split(synonyms, lines, "\n")
		for (i = 1; i <= n; i++) {
			split(lines[i], f, " ")
			syn[f[1]] = f[2]
		}
		while ((getline line < recent_file) > 0)
			if (line != "" && !(line in rank)) { rank[line] = ++nrecent; recent[nrecent] = line }
	}
	{
		k = substr($0, length($1) + 2)
		if (k in meta) next
		nt = split($1, t, ",")
		words = $1
		for (i = 1; i <= nt; i++) if (t[i] in syn) words = words "," syn[t[i]]
		meta[k] = words
		order[++count] = k
	}
	END {
		for (i = 1; i <= nrecent; i++)
			if (recent[i] in meta) printf "%s\0meta\037recent,%s\n", recent[i], meta[recent[i]]
		for (i = 1; i <= count; i++)
			if (!(order[i] in rank)) printf "%s\0meta\037%s\n", order[i], meta[order[i]]
	}
' <<< "$LIST" | rofi -dmenu -i -p "" -theme "$RASI")
[[ -z "$pick" ]] && exit 0

printf '%s' "$pick" | xclip -selection clipboard &

# Give focus a moment to return to the previous window
sleep 0.04
# Default per-char delay is 12ms; 1ms keeps it reliable for remapped unicode keys
xdotool type --clearmodifiers --delay 1 -- "$pick"

{ printf '%s\n' "$pick"; grep -vxF -- "$pick" "$RECENT"; } | head -n "$MAX_RECENT" > "$RECENT.tmp" \
	&& mv "$RECENT.tmp" "$RECENT"
