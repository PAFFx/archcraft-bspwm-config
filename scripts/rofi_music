#!/usr/bin/env bash

## Rofi music controller for any MPRIS player (default: spotify) via playerctl.
## Based on niraj998's rofi music script.
## Dependencies: playerctl curl wmctrl

DIR="$HOME/.config/bspwm"
STYLE="adaptive"
RASI="$DIR/themes/$STYLE/rofi/music.rasi"

# Player to control (any player that shows up in `playerctl -l`)
Control="spotify"

missing=()
for dep in playerctl curl wmctrl; do command -v "$dep" >/dev/null || missing+=("$dep"); done
if ((${#missing[@]})); then
	# Click the notification to install in a floating terminal (pacman asks for your password)
	(
		[[ $(dunstify -u critical -A install,Install "rofi_music: missing ${missing[*]}" "Click to install") == install ]] &&
			alacritty --class 'alacritty-float,alacritty-float' -e sh -c \
				"sudo pacman -S --needed ${missing[*]}; printf '\nPress Enter to close'; read _"
	) &
	exit 1
fi

# Cover art (cached per track), shown by music.rasi
CoverDir=/tmp/cover
Cover="$CoverDir/cover.png"
bkpCover="$DIR/themes/$STYLE/rofi/shared/music.jpg"
mkdir -p "$CoverDir"

meta() { playerctl --player="$Control" metadata --format "{{$1}}" 2>/dev/null; }

title=$(meta title)
artist=$(meta artist)
arturl=$(meta mpris:artUrl | sed -e 's/open.spotify.com/i.scdn.co/g')

cached="$CoverDir/$(echo "${title}-${artist}" | sed -e 's/[\/:*?"<>|]/_/g').png"
if [[ -f $cached ]] || { [[ -n $arturl ]] && curl -sf "$arturl" -o "$cached"; }; then
	cp "$cached" "$Cover"
else
	cp "$bkpCover" "$Cover"
fi

title=${title:-Play Something}
((${#title} > 50)) && title="${title:0:47}..."
artist=${artist:0:35}
artist=${artist:-Artist}

# Icons: Nerd Fonts v3 (nf-md)
player=$'\U000f04c7'
previous=$'\U000f04ae'
next=$'\U000f04ad'
case "$(playerctl --player="$Control" status 2>/dev/null)" in
	Playing) icon=$'\U000f03e4' ;;  # pause
	*)       icon=$'\U000f040a' ;;  # play
esac

chosen=$(printf '%s\n' "$player" "$previous" "$icon" "$next" | rofi -m -4 -theme "$RASI" -dmenu -i \
	-selected-row 2 -hover-select -p "<big><b>$title</b></big>
$artist")

case $chosen in
	"$player")   wmctrl -x -a "$Control" || "$Control" & ;;
	"$previous") playerctl --player="$Control" previous ;;
	"$icon")     playerctl --player="$Control" play-pause ;;
	"$next")     playerctl --player="$Control" next ;;
esac
