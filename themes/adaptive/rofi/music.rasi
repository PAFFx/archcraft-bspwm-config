 * Mini player: square cover on the left, track info + controls on the right.
 **/

/*****----- Global Properties -----*****/
@import                          "shared/colors.rasi"
@import                          "shared/fonts.rasi"

* {
  background-color: transparent;
  text-color:       @foreground;
  icon-font:        "SymbolsNF 26";
}

/*****----- Window -----*****/
window {
  transparency:     "real";
  location:         center;
  anchor:           center;
  fullscreen:       false;
  width:            560px;
  height:           216px;   /* 180px cover + 2 x 18px padding */
  border:           1px solid;
  border-color:     @background-alt;
  border-radius:    16px;
  background-color: @background;
  cursor:           "default";
}

mainbox {
  orientation:      horizontal;
  children:         [ cover, details ];
  spacing:          20px;
  padding:          18px;
  background-color: @background;
}

/*****----- Cover -----*****/
cover {
  expand:           false;
  width:            180px;
  border-radius:    12px;
  background-image: url("/tmp/cover/cover.png", both);
}

/*****----- Track info -----*****/
details {
  orientation:      vertical;
  children:         [ message, spacer, listview ];
  spacing:          0px;
}

message {
  padding:          6px 0px 0px 0px;
}

textbox {
  markup:           true;
  font:             "JetBrainsMono Nerd Font 12";   /* one size: rofi clips mixed-size markup */
}

spacer {
  expand:           true;
}

/*****----- Controls -----*****/
listview {
  layout:           vertical;
  columns:          4;
  lines:            1;
  cycle:            true;
  fixed-height:     true;
  expand:           false;
  spacing:          10px;
  padding:          0px 0px 4px 0px;
}

element {
  cursor:           pointer;
  border-radius:    100%;
  padding:          5px 0px 19px 0px;   /* icon font sits low; shift glyph up 7px */
  margin:           0px 7px;            /* ~74px column -> 59px circle */
}

element-text {
  font:             @icon-font;
  horizontal-align: 0.5;
  vertical-align:   0.5;
  text-color:       inherit;
  cursor:           inherit;
}

element selected {
  background-color: @selected;
  text-color:       @background;
}

element-icon {
  size:             0px;
}
