/*****----- Kaomoji picker (super + e) -----*****/

configuration {
    show-icons:                  false;
}

@import                          "shared/colors.rasi"
@import                          "shared/fonts.rasi"

window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    width:                       820px;
    border:                      0px solid;
    border-radius:               0px;
    background-color:            @background;
}

mainbox {
    spacing:                     12px;
    padding:                     20px;
    background-color:            transparent;
    children:                    [ "inputbar", "listview" ];
}

inputbar {
    spacing:                     10px;
    background-color:            transparent;
    text-color:                  @foreground;
    children:                    [ "textbox-prompt-colon", "entry" ];
}
textbox-prompt-colon {
    padding:                     5px 0px;
    expand:                      false;
    str:                         "(◕‿◕)";
    background-color:            inherit;
    text-color:                  @urgent;
}
entry {
    padding:                     5px 0px;
    background-color:            inherit;
    text-color:                  inherit;
    cursor:                      text;
    placeholder:                 "happy, love, sad, shrug, cat, tableflip...";
    placeholder-color:           inherit;
}

listview {
    columns:                     4;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    fixed-height:                true;
    fixed-columns:               true;
    flow:                        horizontal;
    spacing:                     6px;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      "default";
}

element {
    padding:                     10px 6px;
    background-color:            @background-alt;
    text-color:                  @foreground;
    cursor:                      pointer;
}
element selected.normal {
    background-color:            @selected;
    text-color:                  @background;
}
element-text {
    font:                        "Noto Sans CJK JP 12";
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   none;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}
